# ============================================================
# YouTube News Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials

# ── Local ML Settings (no API key required — recommended) ─────────────────
USE_LOCAL_ML=true                          # true = Flan-T5 (free, offline)
                                           # false = Claude API (requires ANTHROPIC_API_KEY)
ML_MODEL_SCRIPT=google/flan-t5-base         # Script writing model (~250 MB, ~800 MB RAM)
                                           # Use google/flan-t5-large for better quality (needs >2 GB free RAM)
ML_MODEL_META=google/flan-t5-base          # HuggingFace model for title/tags/description (~250 MB)
ML_CACHE_DIR=./models                      # Local folder where downloaded models are stored
ML_MAX_NEW_TOKENS=512                      # Max tokens for script generation (higher = longer scripts)
ML_DEVICE=cpu                              # cpu (change to 'cuda' if you add a GPU later)

# ── Anthropic Claude API (optional — only if USE_LOCAL_ML=false) ──────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── YouTube Data API v3 ───────────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080

# ── Channel Settings ──────────────────────────────────────────────────────
CHANNEL_NAME=YourNewsChannel
CHANNEL_LANGUAGE=en
DEFAULT_CATEGORY_ID=25         # 25 = News & Politics
DEFAULT_PRIVACY=public         # public / unlisted / private

# ── Bot Settings ──────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=30     # How often to check for new articles
MAX_ARTICLES_PER_RUN=5         # Max articles to process per run
VIDEO_RESOLUTION=1920x1080     # 1920x1080 or 1280x720
TTS_ENGINE=gtts                # gtts or pyttsx3
VOICE_LANGUAGE=en              # en, hi, ta, etc.

# ── Output Paths ──────────────────────────────────────────────────────────
OUTPUT_DIR=./output
VIDEO_DIR=./output/videos
THUMBNAIL_DIR=./output/thumbnails
LOG_DIR=./logs

# ── News Sources (comma-separated, enable/disable) ────────────────────────
ENABLE_THE_HINDU=true
ENABLE_INDIA_TODAY=true
ENABLE_NDTV=true
ENABLE_TIMES_OF_INDIA=true
ENABLE_HINDUSTAN_TIMES=true
ENABLE_THE_WIRE=true

# ── Content Filters ───────────────────────────────────────────────────────
MIN_ARTICLE_LENGTH=200         # Minimum chars to process
BLOCKED_KEYWORDS=advertisement,sponsored,promo
PREFERRED_CATEGORIES=politics,technology,business,sports,science
