# ═══════════════════════════════════════════════════════════════════════
#  YouTube News Bot — .gitignore
#  Public repository — excludes secrets, credentials, generated outputs,
#  ML models, and OS/IDE artifacts.
# ═══════════════════════════════════════════════════════════════════════

# ── Python bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.conda/

# ── Distribution / packaging ────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.whl
*.tar.gz
sdist/
wheels/
pip-wheel-metadata/

# ── Secrets & credentials (CRITICAL — never commit) ─────────────────
.env
*.env.local
client_secrets.json
youtube_token.pickle
token.json
credentials.json
*_secret*.json
*.pem
*.key

# ── ML models & caches (large binaries, user-downloaded) ────────────
models/
*.onnx
*.onnx.json
*.bin
*.safetensors
*.h5
*.pt
*.pth
CACHEDIR.TAG

# ── TTS engine binaries ─────────────────────────────────────────────
bin/piper/
piper.zip

# ── Generated outputs ───────────────────────────────────────────────
output/
logs/
*.mp4
*.mp3
*.wav
*.webm

# ── Scratch / temporary files ────────────────────────────────────────
scratch/
tmp/
temp/

# ── Jupyter Notebooks checkpoints ───────────────────────────────────
.ipynb_checkpoints/

# ── IDE / Editor settings ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS-generated files ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Testing / coverage ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Type checking / linting ─────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pylint.d/

# ── Misc ────────────────────────────────────────────────────────────
*.log
*.bak
*.orig
